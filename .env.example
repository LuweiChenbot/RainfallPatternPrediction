# Copy this file to .env (same folder) and adjust it per machine; .env is not committed.
# VS Code passes these to notebook kernels, and task2/run_pipeline.py reads them too.

# CPU cores and memory Spark may use (local mode: memory is the whole Spark heap, about 70 % of the RAM)
RAIN_SPARK_CORES=8
RAIN_SPARK_MEMORY=10g
RAIN_SHUFFLE_PARTITIONS=96

# Training table: train_frac0.1 (all wet rows, 10 % of dry rows) or train_full (every row, needs about 32 GB)
RAIN_TRAIN=train_frac0.1

# Trees per random forest
RAIN_RF_TREES=50

# Optional: folder for Spark's temporary files (use a fast disk with 20 GB free)
# RAIN_SPARK_LOCAL_DIR=D:/spark-tmp
